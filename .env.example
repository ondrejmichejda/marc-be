# ==========================================
# Database Configuration (Neon PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.c-8.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ==========================================
# Telegram Bot Configuration
# ==========================================

# (Required) Bot Token from Telegram @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# (Optional, Recommended) Secret token for securing the webhook
# Telegram will send this in the 'x-telegram-bot-api-secret-token' header
TELEGRAM_WEBHOOK_SECRET="your-random-secret-token-string"

# (Optional) Public URL where your backend is hosted (e.g. https://your-domain.com or ngrok URL)
# Used by the setup-webhook endpoint to automatically register webhook with Telegram
APP_URL="https://your-public-url.ngrok-free.app"

# (Optional) Comma-separated list of Telegram User IDs allowed to execute admin commands (e.g. /broadcast)
TELEGRAM_ADMIN_IDS="123456789"

# (Optional) Secret key to authenticate deployment notification requests (defaults to TELEGRAM_WEBHOOK_SECRET)
ADMIN_API_KEY="your-admin-secret-key"

# (Optional) Automatically broadcast deployment notifications on server startup (true / false)
AUTO_NOTIFY_DEPLOYMENT="false"

# ==========================================
# Google / Gmail Authentication (OAuth 2.0)
# ==========================================

# (Required for Google Auth) Client ID obtained from Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# (Required for Google Auth) Client Secret obtained from Google Cloud Console
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# (Optional) Secret key used to sign and verify session JWTs (defaults to TELEGRAM_WEBHOOK_SECRET or dev key)
AUTH_SECRET="your-secure-random-auth-secret-string"

# (Optional) Comma-separated list of emails automatically assigned Administrator role upon login
ADMIN_EMAILS="admin@example.com,developer@example.com"

# (Optional) Custom redirect URI override (defaults to ${APP_URL}/api/auth/google/callback)
# GOOGLE_REDIRECT_URI="https://your-domain.com/api/auth/google/callback"

# ==========================================
# OpenAI Configuration
# ==========================================

# (Required) OpenAI API Key
OPENAI_API_KEY="your-openai-api-key"

# (Optional) Model selection (defaults to gpt-4o-mini)
OPENAI_MODEL="gpt-4o-mini"
